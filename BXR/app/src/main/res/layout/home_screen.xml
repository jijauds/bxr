<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/train_button"
            android:layout_width="260dp"
            android:layout_height="180dp"
            android:background="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/practice"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/manual_button"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/gray">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="HOW TO USE"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="@font/jersey"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/settings_button"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/gray">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="SETTINGS"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="@font/jersey"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/about_button"
            android:layout_width="240dp"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/gray">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="ABOUT"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="@font/jersey"/>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/logs_button"
            android:layout_width="232dp"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/gray"
            android:lineSpacingExtra="60sp"
            android:text="Logs"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:typeface="monospace"
            app:layout_constraintEnd_toEndOf="@+id/train_button"
            app:layout_constraintStart_toStartOf="@+id/train_button"
            app:layout_constraintTop_toBottomOf="@+id/train_button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>