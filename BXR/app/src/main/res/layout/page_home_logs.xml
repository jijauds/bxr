<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:padding="40dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_back"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="wrap_content"
        android:layout_centerInParent="true"
        android:text="No logs found"
        android:textColor="#88FFFFFF"
        android:textSize="24sp"
        android:fontFamily="@font/jersey"
        android:visibility="gone"
        android:layout_height="10dp" />

    <TextView
        android:id="@+id/tvMoveTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="Jab"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="@font/jersey"/>

    <LinearLayout
        android:id="@+id/layoutSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvMoveTitle"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_card_glow">

        <TextView
            android:id="@+id/tvSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Common mistakes for Jab"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="@font/jersey"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSummaryErrors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/jersey"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMoves"
        android:layout_marginTop="24dp"
        android:layout_width="259dp"
        android:layout_height="417dp"
        android:layout_below="@id/layoutSummary"
        android:layout_centerInParent="true"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/recyclerMoves"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:layout_centerHorizontal="true"/>

    <Button
        android:id="@+id/btnView"
        android:layout_width="161dp"
        android:layout_height="73dp"
        android:layout_below="@id/layoutDots"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="29dp"
        android:backgroundTint="@color/accent"
        android:fontFamily="@font/jersey"
        android:text="VIEW"
        android:textColor="@color/white"
        android:textSize="36sp"
        android:textStyle="bold"
        android:typeface="monospace"/>

</RelativeLayout>